{
  "name": "eluma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "pnpm build:agent && vite",
    "build:shell": "tsc -b && vite build",
    "build:agent": "vite build --config vite.agent.config.ts",
    "build": "pnpm build:agent && pnpm build:shell",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "tauri": "tauri",
    "lint:rust": "cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "format:rust": "cargo fmt"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
